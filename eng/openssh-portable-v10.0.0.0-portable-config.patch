diff --git a/ssh.c b/ssh.c
index ea94d25106cf600e6ec1c39974ecc9047471244b..eabf82d78529e20f0f249a2739888f6031fc684d 100644
--- a/ssh.c
+++ b/ssh.c
@@ -112,6 +112,10 @@
 #include "myproposal.h"
 #include "utf8.h"
 
+#ifdef WINDOWS
+#include "misc_internal.h"
+#endif
+
 #ifdef ENABLE_PKCS11
 #include "ssh-pkcs11.h"
 #endif
@@ -556,6 +560,40 @@ check_load(int r, struct sshkey **k, const char *path, const char *message)
 	}
 }
 
+#ifdef WINDOWS
+#define PORTABLE_EXECUTABLE_DIRECTORY_SUFFIX	"/usr/bin"
+#define PORTABLE_SYSTEM_CONFIG_SUFFIX		"/etc/ssh/ssh_config"
+
+static const char *
+systemwide_config_file(void)
+{
+#ifdef SSH_PORTABLE_GLOBAL_CONFIG
+	static char config_path[PATH_MAX];
+	char executable_dir[PATH_MAX];
+	size_t executable_dir_len, suffix_len;
+	int r;
+
+	if (realpath(__progdir, executable_dir) == NULL)
+		fatal("Cannot resolve portable executable directory \"%s\": %s",
+		    __progdir, strerror(errno));
+	executable_dir_len = strlen(executable_dir);
+	suffix_len = sizeof(PORTABLE_EXECUTABLE_DIRECTORY_SUFFIX) - 1;
+	if (executable_dir_len <= suffix_len ||
+	    strcasecmp(executable_dir + executable_dir_len - suffix_len,
+	    PORTABLE_EXECUTABLE_DIRECTORY_SUFFIX) != 0)
+		fatal("Portable ssh.exe must run from a usr/bin directory");
+	executable_dir[executable_dir_len - suffix_len] = '\0';
+	r = snprintf(config_path, sizeof(config_path), "%s%s", executable_dir,
+	    PORTABLE_SYSTEM_CONFIG_SUFFIX);
+	if (r < 0 || (size_t)r >= sizeof(config_path))
+		fatal("Portable global config path is too long");
+	return config_path;
+#else
+	return _PATH_HOST_CONFIG_FILE;
+#endif
+}
+#endif
+
 /*
  * Read per-user configuration file.  Ignore the system wide config
  * file if the user specifies a config file on the command line.
@@ -592,7 +630,7 @@ process_config_files(const char *host_name, struct passwd *pw,
 		 *	If a non-admin user creates the systemwide folder then systemwide ssh_config inherits parent folder permissions i.e., non-admin user have write permissions.
 		 *	This is not desirable. For windows, We make sure the systemwide sshd_config file is not editable by non-admin users.
 		 */
-		(void)read_config_file(_PATH_HOST_CONFIG_FILE, pw,
+		(void)read_config_file(systemwide_config_file(), pw,
 			host, host_name, cmd, &options, SSHCONF_CHECKPERM |
 			(final_pass ? SSHCONF_FINAL : 0), want_final_pass);
 #else
