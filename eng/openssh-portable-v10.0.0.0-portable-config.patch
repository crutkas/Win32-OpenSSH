diff --git a/ssh.c b/ssh.c
--- a/ssh.c
+++ b/ssh.c
@@ -112,6 +112,10 @@
 #include "myproposal.h"
 #include "utf8.h"
 
+#ifdef WINDOWS
+#include "misc_internal.h"
+#endif
+
 #ifdef ENABLE_PKCS11
 #include "ssh-pkcs11.h"
 #endif
@@ -556,6 +560,36 @@ check_load(int r, struct sshkey **k, const char *path, const char *message)
 	}
 }
 
+#ifdef WINDOWS
+/*
+ * A client build may opt in to an executable-relative system configuration.
+ * Builds without the property retain the standard ProgramData path.
+ */
+static const char *
+systemwide_config_file(void)
+{
+#ifdef SSH_PORTABLE_GLOBAL_CONFIG
+	static char resolved[PATH_MAX];
+	char joined[PATH_MAX];
+	int r;
+
+	if (SSH_PORTABLE_GLOBAL_CONFIG[0] == '\0' ||
+	    is_absolute_path(SSH_PORTABLE_GLOBAL_CONFIG))
+		fatal("Portable global config path must be relative");
+	r = snprintf(joined, sizeof(joined), "%s/%s", __progdir,
+	    SSH_PORTABLE_GLOBAL_CONFIG);
+	if (r < 0 || (size_t)r >= sizeof(joined))
+		fatal("Portable global config path is too long");
+	if (realpath(joined, resolved) == NULL)
+		fatal("Cannot resolve portable global config path \"%s\": %s",
+		    joined, strerror(errno));
+	return resolved;
+#else
+	return _PATH_HOST_CONFIG_FILE;
+#endif
+}
+#endif
+
 /*
  * Read per-user configuration file.  Ignore the system wide config
  * file if the user specifies a config file on the command line.
@@ -593,6 +627,6 @@ process_config_files(const char *host_name, struct passwd *pw,
 		 *	This is not desirable. For windows, We make sure the systemwide sshd_config file is not editable by non-admin users.
 		 */
-		(void)read_config_file(_PATH_HOST_CONFIG_FILE, pw,
+		(void)read_config_file(systemwide_config_file(), pw,
 			host, host_name, cmd, &options, SSHCONF_CHECKPERM |
 			(final_pass ? SSHCONF_FINAL : 0), want_final_pass);
 #else
